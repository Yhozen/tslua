rockspec_format = "3.0"
package = "tslua"
version = "dev-1"
source = {
   url = "git+https://github.com/Yhozen/tslua.git",
}
description = {
   summary = "A faithful Lua port of the TypeScript 7 (typescript-go) compiler",
   detailed = [[
tslua is a mechanical port of microsoft/typescript-go to Lua 5.4: scanner, parser,
binder, type checker and emitter, validated against the upstream baseline test suite.
]],
   homepage = "https://github.com/Yhozen/tslua",
   license = "Apache-2.0",
}
dependencies = {
   "lua >= 5.4",
}
test_dependencies = {
   "busted",
}
test = {
   type = "busted",
}
build = {
   type = "builtin",
   -- Modules are auto-detected from src/ (src/tslua/<pkg>/init.lua -> tslua.<pkg>).
   -- The test runners (bin/tslua-test, bin/tslua-tsctest, bin/tslua-fourslash) need the upstream
   -- checkout in vendor/ and run from the source tree, so only the compiler CLI is installed.
   copy_directories = {},
   install = {
      bin = { tslua = "bin/tslua" },
      -- tslua.bundled reads the lib .d.ts files from libs/ next to its own source file, so they are
      -- installed into the module tree. A key "a.b.c" installs the file into a/b/ keeping its file
      -- name. Keep in sync with src/tslua/bundled/libs (checked by spec/rockspec_spec.lua).
      lua = {
         ["tslua.bundled.libs.lib"] = "src/tslua/bundled/libs/lib.d.ts",
         ["tslua.bundled.libs.lib_decorators"] = "src/tslua/bundled/libs/lib.decorators.d.ts",
         ["tslua.bundled.libs.lib_decorators_legacy"] = "src/tslua/bundled/libs/lib.decorators.legacy.d.ts",
         ["tslua.bundled.libs.lib_dom_asynciterable"] = "src/tslua/bundled/libs/lib.dom.asynciterable.d.ts",
         ["tslua.bundled.libs.lib_dom"] = "src/tslua/bundled/libs/lib.dom.d.ts",
         ["tslua.bundled.libs.lib_dom_iterable"] = "src/tslua/bundled/libs/lib.dom.iterable.d.ts",
         ["tslua.bundled.libs.lib_es2015_collection"] = "src/tslua/bundled/libs/lib.es2015.collection.d.ts",
         ["tslua.bundled.libs.lib_es2015_core"] = "src/tslua/bundled/libs/lib.es2015.core.d.ts",
         ["tslua.bundled.libs.lib_es2015"] = "src/tslua/bundled/libs/lib.es2015.d.ts",
         ["tslua.bundled.libs.lib_es2015_generator"] = "src/tslua/bundled/libs/lib.es2015.generator.d.ts",
         ["tslua.bundled.libs.lib_es2015_iterable"] = "src/tslua/bundled/libs/lib.es2015.iterable.d.ts",
         ["tslua.bundled.libs.lib_es2015_promise"] = "src/tslua/bundled/libs/lib.es2015.promise.d.ts",
         ["tslua.bundled.libs.lib_es2015_proxy"] = "src/tslua/bundled/libs/lib.es2015.proxy.d.ts",
         ["tslua.bundled.libs.lib_es2015_reflect"] = "src/tslua/bundled/libs/lib.es2015.reflect.d.ts",
         ["tslua.bundled.libs.lib_es2015_symbol"] = "src/tslua/bundled/libs/lib.es2015.symbol.d.ts",
         ["tslua.bundled.libs.lib_es2015_symbol_wellknown"] = "src/tslua/bundled/libs/lib.es2015.symbol.wellknown.d.ts",
         ["tslua.bundled.libs.lib_es2016_array_include"] = "src/tslua/bundled/libs/lib.es2016.array.include.d.ts",
         ["tslua.bundled.libs.lib_es2016"] = "src/tslua/bundled/libs/lib.es2016.d.ts",
         ["tslua.bundled.libs.lib_es2016_full"] = "src/tslua/bundled/libs/lib.es2016.full.d.ts",
