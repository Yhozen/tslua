#!/usr/bin/env lua
-- tslua-fourslash: runs the fourslash language-service tests converted from typescript-go's
-- internal/fourslash/tests (tests/fourslash/{gen,manual,tests}/*.lua, generated by
-- scripts/gen/fourslash.mjs) through tslua.fourslash, the port of the Go harness. Tests that
-- baseline compare against vendor/typescript-go/testdata/baselines/reference/fourslash (local
-- outputs go to tests/out/); the others check their inline verify.* assertions. Go's skips are
-- kept: fourslash.SkipIfFailing (internal/fourslash/_scripts/failingTests.txt) and t.Skip.
--
-- A test id is <dir>/<Go test name>, e.g. gen/TestAddDeclareToFunction.

local USAGE = [[
usage: bin/tslua-fourslash [options] [test-id-or-file]...

options:
  --all                 run every converted test (default when no test is given)
  --passing             run the tests listed in tests/passing/fourslash.txt and fail on regressions
  --update-passing      add the newly passing tests to tests/passing/fourslash.txt
  --filter <pattern>    only tests whose id contains <pattern> (plain text, or a Lua pattern)
  --dir <d>             only tests of gen, manual or tests (repeatable)
  --jobs N              run test files in N parallel `lua` subprocesses (default 1: in-process)
  --batch K             test files per subprocess with --jobs (default 8)
  --timeout S           per-test timeout in seconds (default 120; 0 disables)
  --list                only list the selected test ids
  -v, --verbose         print failure messages
  -q, --quiet           only print failures and the summary
]]

local scriptPath = arg and arg[0] or "bin/tslua-fourslash"
local scriptDir = string.match(scriptPath, "^(.*)/[^/]*$") or "."
local root = scriptDir .. "/.."
package.path = root .. "/src/?.lua;" .. root .. "/src/?/init.lua;" .. package.path

local interpreter = "lua"
do
    local i = -1
    while arg and arg[i] ~= nil do
        interpreter = arg[i]
        i = i - 1
    end
end

local DIRS = { "gen", "manual", "tests" }
local TIMEOUT_MARKER = "@@fourslash-timeout@@"

local function shellQuote(s)
    return "'" .. string.gsub(s, "'", "'\\''") .. "'"
end

local function readFile(path)
    local f = io.open(path, "rb")
    if f == nil then
        return nil
    end
    local s = f:read("a")
    f:close()
    return s
end

local function writeFile(path, data)
    local f = assert(io.open(path, "wb"))
    f:write(data)
    f:close()
end

local function sortedKeys(t)
    local keys = {}
    for k in pairs(t) do
        keys[#keys + 1] = k
    end
    table.sort(keys)
    return keys
end

local function escape(s)
    return (string.gsub(s, "[\\\n\t]", { ["\\"] = "\\\\", ["\n"] = "\\n", ["\t"] = "\\t" }))
end

local function unescape(s)
    return (string.gsub(s, "\\(.)", { ["\\"] = "\\", n = "\n", t = "\t" }))
end

-- Options.

local opts = {
    all = false,
    passing = false,
    updatePassing = false,
    filters = {},
    dirs = nil,
    jobs = 1,
    batch = 8,
    timeout = 120,
    list = false,
    verbose = false,
    quiet = false,
    worker = false,
    args = {},
}

do
    local i = 1
    local function value(name)
        i = i + 1
        if arg[i] == nil then
            io.stderr:write("missing value for " .. name .. "\n")
            os.exit(2)
        end
        return arg[i]
    end
    while arg[i] ~= nil do
        local a = arg[i]
        if a == "--all" then
            opts.all = true
        elseif a == "--passing" then
            opts.passing = true
        elseif a == "--update-passing" then
            opts.updatePassing = true
        elseif a == "--filter" then
            opts.filters[#opts.filters + 1] = value(a)
        elseif a == "--dir" then
            opts.dirs = opts.dirs or {}
            opts.dirs[value(a)] = true
        elseif a == "--jobs" then
            opts.jobs = tonumber(value(a)) or 1
        elseif a == "--batch" then
            opts.batch = tonumber(value(a)) or 8
        elseif a == "--timeout" then
            opts.timeout = tonumber(value(a)) or 120
        elseif a == "--list" then
            opts.list = true
        elseif a == "-v" or a == "--verbose" then
            opts.verbose = true
        elseif a == "-q" or a == "--quiet" then
            opts.quiet = true
        elseif a == "--worker" then
            opts.worker = true
        elseif a == "-h" or a == "--help" then
            io.write(USAGE)
            os.exit(0)
        elseif string.sub(a, 1, 2) == "--" then
            io.stderr:write("unknown option " .. a .. "\n" .. USAGE)
            os.exit(2)
        else
            opts.args[#opts.args + 1] = a
        end
        i = i + 1
    end
end

local passingFile = root .. "/tests/passing/fourslash.txt"

local function readPassing()
    local set = {}
    for line in string.gmatch(readFile(passingFile) or "", "[^\n]+") do
        line = string.match(line, "^%s*(.-)%s*$")
        if line ~= "" and string.sub(line, 1, 1) ~= "#" then
            set[line] = true
        end
    end
    return set
end

local function idMatchesFilter(id)
    if #opts.filters == 0 then
        return true
    end
    for _, f in ipairs(opts.filters) do
        if string.find(id, f, 1, true) then
            return true
        end
        local ok, found = pcall(string.find, id, f)
        if ok and found then
            return true
        end
    end
    return false
end

-- Test files and the test names they define (from the generated `{ name = "TestX", ... }` lines,
-- without loading them).

local function listDir(dir)
    local files = {}
    local p = io.popen("ls " .. shellQuote(root .. "/tests/fourslash/" .. dir) .. " 2>/dev/null")
    if p then
        for name in p:lines() do
            if string.match(name, "%.lua$") then
                files[#files + 1] = name
            end
        end
        p:close()
    end
    table.sort(files)
    return files
end

local function testNamesOf(path)
    local names = {}
    for name in string.gmatch(readFile(root .. "/" .. path) or "", "{ name = \"([^\"]+)\", fn = ") do
        names[#names + 1] = name
    end
    return names
end

-- Running.

local loaded = false
local testutil

local function loadHarness()
    if not loaded then
        loaded = true
        testutil = require("tslua.testutil")

        require("tslua.fourslash")
    end
end

local function collectMessages(t, out)
    for _, m in ipairs(t.messages) do
        out[#out + 1] = (t.fullName ~= "" and (t.fullName .. ": ") or "") .. m
    end
    for _, c in ipairs(t.children) do
        collectMessages(c, out)
    end
    return out
end

local function anyFailed(t)
    if t.failed then
        return true
    end
    for _, c in ipairs(t.children) do
        if anyFailed(c) then
            return true
        end
    end
    return false
end

local function allSkipped(t)
    if t.skipped then
        return true
    end
    if #t.children == 0 then
        return false
    end
    for _, c in ipairs(t.children) do
        if not allSkipped(c) then
            return false
        end
    end
    return true
end

local function hasPanic(t)
    if t.panicked ~= nil then
        return true
    end
    for _, c in ipairs(t.children) do
        if hasPanic(c) then
            return true
        end
    end
    return false
end

-- Runs every selected test of one file; returns { { id, status, messages } }.
local function runFileInProcess(path, wanted)
    loadHarness()
    local dir = string.match(path, "^tests/fourslash/([^/]+)/")
    local results = {}
    local chunk, err = loadfile(root .. "/" .. path)
    local mod
    if chunk ~= nil then
        local ok, m = xpcall(chunk, debug.traceback)
        if ok then
            mod = m
        else
            err = m
        end
    end
    if mod == nil then
        for _, name in ipairs(testNamesOf(path)) do
            if wanted == nil or wanted[name] then
                results[#results + 1] = { id = dir .. "/" .. name, status = "crash", messages = { "loading " .. path .. ": " .. tostring(err) } }
            end
        end
        return results
    end
    for _, test in ipairs(mod.tests) do
        if wanted == nil or wanted[test.name] then
            local t = testutil.NewT(test.name, nil)
            local deadline = math.huge
            if opts.timeout > 0 then
                deadline = os.clock() + opts.timeout
                debug.sethook(function()
                    if os.clock() > deadline then
                        deadline = math.huge
                        error(TIMEOUT_MARKER, 0)
                    end
                end, "", 1000000)
            end
            testutil.runProtected(t, test.fn)
            debug.sethook()
            local messages = collectMessages(t, {})
            local status
            local text = table.concat(messages, "\n")
            if string.find(text, TIMEOUT_MARKER, 1, true) then
                status = "timeout"
            elseif anyFailed(t) then
                status = hasPanic(t) and "crash" or "fail"
            elseif allSkipped(t) then
                status = "skip"
            else
                status = "pass"
            end
            results[#results + 1] = { id = dir .. "/" .. test.name, status = status, messages = messages }
        end
    end
    return results
end

-- A worker runs the given files ("path|Name,Name" entries) and prints one result line per test.
if opts.worker then
    for _, a in ipairs(opts.args) do
        local path, names = string.match(a, "^([^|]*)|(.*)$")
        local wanted = {}
        for n in string.gmatch(names, "[^,]+") do
            wanted[n] = true
        end
        local ok, results = pcall(runFileInProcess, path, wanted)
        if not ok then
            local e = tostring(results)
            results = {}
            local dir = string.match(path, "^tests/fourslash/([^/]+)/")
            for n in pairs(wanted) do
                results[#results + 1] = { id = dir .. "/" .. n, status = "crash", messages = { e } }
            end
        end
        local lines = {}
        for _, r in ipairs(results) do
            lines[#lines + 1] = table.concat({ "@@RESULT", r.id, r.status, escape(table.concat(r.messages, "\n")) }, "\t")
        end
        lines[#lines + 1] = "@@DONE\t" .. path
        io.stdout:write(table.concat(lines, "\n") .. "\n")
        io.stdout:flush()
    end
    os.exit(0)
end

-- Selection: path -> set of test names (in file order through fileOrder).

local selection = {}
local fileOrder = {}
local idToFile = nil

local function select(path, name)
    if selection[path] == nil then
        selection[path] = { names = {}, order = {} }
        fileOrder[#fileOrder + 1] = path
    end
    if not selection[path].names[name] then
        selection[path].names[name] = true
        selection[path].order[#selection[path].order + 1] = name
    end
end

local function dirSelected(dir)
    return opts.dirs == nil or opts.dirs[dir]
end

local function buildIndex()
    if idToFile == nil then
        idToFile = {}
        for _, dir in ipairs(DIRS) do
            for _, file in ipairs(listDir(dir)) do
                local path = "tests/fourslash/" .. dir .. "/" .. file
                for _, name in ipairs(testNamesOf(path)) do
                    idToFile[dir .. "/" .. name] = path
                end
            end
        end
    end
    return idToFile
end

local function selectAll()
    for _, dir in ipairs(DIRS) do
        if dirSelected(dir) then
            for _, file in ipairs(listDir(dir)) do
                local path = "tests/fourslash/" .. dir .. "/" .. file
                for _, name in ipairs(testNamesOf(path)) do
                    if idMatchesFilter(dir .. "/" .. name) then
                        select(path, name)
                    end
                end
            end
        end
    end
end

local passingSet = readPassing()

if opts.passing then
    local index = buildIndex()
    for _, id in ipairs(sortedKeys(passingSet)) do
        local path = index[id]
        if path == nil then
            io.stderr:write("warning: passing list entry " .. id .. " does not name a test\n")
        elseif idMatchesFilter(id) and dirSelected(string.match(id, "^[^/]+")) then
            select(path, string.match(id, "/(.*)$"))
        end
    end
end

for _, a in ipairs(opts.args) do
    local index = buildIndex()
    if index[a] ~= nil then
        select(index[a], string.match(a, "/(.*)$"))
    else
        local path = string.match(a, "(tests/fourslash/[^/]+/[^/]+%.lua)$")
        if path == nil then
            -- a bare test name (TestX) or file base name
            for id, p in pairs(index) do
                if string.match(id, "/(.*)$") == a or string.match(p, "([^/]*)%.lua$") == a or string.match(p, "([^/]*)%.lua$") == a .. "_test" then
                    select(p, string.match(id, "/(.*)$"))
                end
            end
        else
            for _, name in ipairs(testNamesOf(path)) do
                select(path, name)
            end
        end
    end
end

if opts.all or (#opts.args == 0 and not opts.passing) then
    selectAll()
end

table.sort(fileOrder)

local total = 0
for _, path in ipairs(fileOrder) do
    total = total + #selection[path].order
end

if opts.list then
    for _, path in ipairs(fileOrder) do
        for _, name in ipairs(selection[path].order) do
            print(string.match(path, "^tests/fourslash/([^/]+)/") .. "/" .. name)
        end
    end
    os.exit(0)
end

-- Run.

local results = {}
local done = 0
local startTime = os.time()

local function report(r)
    done = done + 1
    results[#results + 1] = r
    local failed = r.status ~= "pass" and r.status ~= "skip"
    if not opts.quiet or failed then
        local label = r.status == "pass" and "ok" or string.upper(r.status)
        io.write(string.format("[%d/%d] %-7s %s\n", done, total, label, r.id))
        if opts.verbose and failed then
            for _, m in ipairs(r.messages) do
                io.write("      " .. string.gsub(m, "\n", "\n      ") .. "\n")
            end
        end
        io.stdout:flush()
    end
end

if opts.jobs <= 1 then
    for _, path in ipairs(fileOrder) do
        local ok, rs = pcall(runFileInProcess, path, selection[path].names)
        if not ok then
            rs = {}
            for _, name in ipairs(selection[path].order) do
                rs[#rs + 1] = { id = string.match(path, "^tests/fourslash/([^/]+)/") .. "/" .. name, status = "crash", messages = { tostring(rs) } }
            end
        end
        for _, r in ipairs(rs) do
            report(r)
        end
    end
else
    local listFile = os.tmpname()
    local lines = {}
    for _, path in ipairs(fileOrder) do
        lines[#lines + 1] = path .. "|" .. table.concat(selection[path].order, ",")
    end
    writeFile(listFile, table.concat(lines, "\n") .. "\n")
    local hardTimeout = ""
    if opts.timeout > 0 then
        hardTimeout = "timeout -k 5 " .. tostring(math.floor(opts.timeout * opts.batch * 2 + 60)) .. " "
    end
    local cmd = "cd " .. shellQuote(root) .. " && xargs -d '\\n' -P " .. opts.jobs .. " -n " .. opts.batch .. " " .. hardTimeout
        .. shellQuote(interpreter) .. " bin/tslua-fourslash --worker --timeout " .. tostring(opts.timeout)
        .. " < " .. shellQuote(listFile) .. " 2>&1"
    local seen = {}
    local p = assert(io.popen(cmd))
    for line in p:lines() do
        local id, status, msg = string.match(line, "^@@RESULT\t([^\t]*)\t([^\t]*)\t(.*)$")
        if id ~= nil then
            seen[id] = true
            local m = unescape(msg)
            report({ id = id, status = status, messages = m ~= "" and { m } or {} })
        elseif opts.verbose and not string.match(line, "^@@DONE") then
            io.stderr:write(line .. "\n")
        end
    end
    p:close()
    os.remove(listFile)
    -- tests whose worker died (hard timeout or interpreter crash)
    for _, path in ipairs(fileOrder) do
        for _, name in ipairs(selection[path].order) do
            local id = string.match(path, "^tests/fourslash/([^/]+)/") .. "/" .. name
            if not seen[id] then
                report({ id = id, status = "timeout", messages = { "worker process died or was killed" } })
            end
        end
    end
end

-- Results (with the failure messages) for triage: tests/out/fourslash-results.txt.
do
    os.execute("mkdir -p " .. shellQuote(root .. "/tests/out"))
    local out = {}
    for _, r in ipairs(results) do
        out[#out + 1] = r.status .. "\t" .. r.id
        if r.status ~= "pass" and r.status ~= "skip" then
            for _, m in ipairs(r.messages) do
                out[#out + 1] = "    " .. string.gsub(string.sub(m, 1, 3000), "\n", "\n    ")
            end
        end
    end
    writeFile(root .. "/tests/out/fourslash-results.txt", table.concat(out, "\n") .. "\n")
end

-- Summary.

local counts = { pass = 0, fail = 0, crash = 0, timeout = 0, skip = 0 }
for _, r in ipairs(results) do
    counts[r.status] = (counts[r.status] or 0) + 1
end
local ran = counts.pass + counts.fail + counts.crash + counts.timeout
io.write(string.format("\n%d tests in %ds: %d pass, %d fail, %d crash, %d timeout, %d skip", #results, os.time() - startTime,
    counts.pass, counts.fail, counts.crash, counts.timeout, counts.skip))
if ran > 0 then
    io.write(string.format(" (%.1f%% of non-skipped)", 100 * counts.pass / ran))
end
io.write("\n")

local exitCode = 0
if opts.passing then
    local regressions = {}
    for _, r in ipairs(results) do
        if passingSet[r.id] and r.status ~= "pass" then
            regressions[#regressions + 1] = r
        end
    end
    table.sort(regressions, function(a, b)
        return a.id < b.id
    end)
    if #regressions > 0 then
        io.write(string.format("\n%d regression(s):\n", #regressions))
        for _, r in ipairs(regressions) do
            io.write(string.format("  %s %s\n", r.id, r.status))
        end
        exitCode = 1
    else
        io.write("\nno regressions\n")
    end
end

if opts.updatePassing then
    local added = 0
    for _, r in ipairs(results) do
        if r.status == "pass" and not passingSet[r.id] then
            passingSet[r.id] = true
            added = added + 1
        end
    end
    local ids = sortedKeys(passingSet)
    writeFile(passingFile, table.concat(ids, "\n") .. (#ids > 0 and "\n" or ""))
    io.write(string.format("%d newly passing test(s) added to tests/passing/fourslash.txt\n", added))
end

os.exit(exitCode)
